# Copy this to .env and add your key. Never commit .env
# Get a key at https://serpapi.com/
SERPAPI_API_KEY=your_key_here
# Optional: get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Set to false to always hit live API (uses quota). True reuses local JSON cache.
USE_CACHE=true
PORT=8000
