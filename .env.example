# Copy this to .env and add your key. Never commit .env
# Get a key at https://serpapi.com/
SERPAPI_API_KEY=your_key_here
# Optional: get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
# false = always hit live API (uses quota). true reuses local JSON cache.
USE_CACHE=false
PORT=8000
# Optional: comma-separated extra origins allowed to call /api/* cross-origin.
# Empty (default) = same-origin only. Example: CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Optional: honor X-Forwarded-For for rate limiting (only behind your own proxy).
TRUST_PROXY_HEADERS=false
# Optional: cap per live SerpApi call so a stalled provider can't hang the app (min 5).
SERPAPI_TIMEOUT_SECONDS=20
# Optional: shorter cap for optional enrichments (weather/events/fx/know/videos, min 4, max = above).
# Optionals fail fast and never stall the trip.
SERPAPI_TIMEOUT_OPTIONAL_SECONDS=8
